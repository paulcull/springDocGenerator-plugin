# Enable lombok annotations
lombok.addLombokGeneratedAnnotation = true

# Configure logging
lombok.log.fieldName = log

# Configure @Data behavior
lombok.data.flagUsage = WARNING
lombok.equalsAndHashCode.callSuper = CALL

# Configure @Builder behavior
lombok.builder.flagUsage = WARNING

# Configure @Value behavior
lombok.value.flagUsage = WARNING

# Configure @NonNull behavior
lombok.nonNull.exceptionType = IllegalArgumentException

# Configure @Cleanup behavior
lombok.cleanup.flagUsage = WARNING

# Configure @SneakyThrows behavior
lombok.sneakyThrows.flagUsage = WARNING

# Configure @Synchronized behavior
lombok.synchronized.flagUsage = WARNING

# Configure @Getter/@Setter behavior
lombok.getter.noIsPrefix = true
lombok.setter.flagUsage = WARNING
lombok.getter.flagUsage = WARNING

# Configure @ToString behavior
lombok.toString.includeFieldNames = true
lombok.toString.flagUsage = WARNING

# Configure @NoArgsConstructor behavior
lombok.noArgsConstructor.flagUsage = WARNING

# Configure @AllArgsConstructor behavior
lombok.allArgsConstructor.flagUsage = WARNING

# Configure @RequiredArgsConstructor behavior
lombok.requiredArgsConstructor.flagUsage = WARNING

# Configure @AnyConstructor behavior
lombok.anyConstructor.addConstructorProperties = true

# Configure @StopBubbling behavior
config.stopBubbling = true 